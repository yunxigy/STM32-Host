# Copy this file to /etc/stm32-host/4G.env on a Linux server.
# Do not commit the real file: it contains deployment-specific settings.

STM32_HTTP_PORT=8007
STM32_TCP_PORT=8008

# RTCM3 relay: base station uploads to PORT_IN, rovers connect to PORT_OUT.
# 8017/8018 are reserved for this module; 8009/8010 belong to the toolbox
# research-reports and document-converter services.
STM32_RTCM_ENABLED=1
STM32_RTCM_PORT_IN=8017
STM32_RTCM_PORT_OUT=8018

# Use the public browser origin. Multiple origins are comma separated.
# Same-origin access through Nginx normally needs only the site origin.
STM32_ALLOWED_ORIGINS=http://your-domain.example

# Keep these outside the source tree so upgrades do not erase GNSS references
# or cloud alarm settings.
STM32_GNSS_STATE_DIR=/var/lib/stm32-host/gnss_runtime
STM32_ALARM_SETTINGS_PATH=/var/lib/stm32-host/alarm_settings.json

PYTHONUNBUFFERED=1
